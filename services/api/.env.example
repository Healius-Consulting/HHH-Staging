PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
NODE_ENV=development
FIREBASE_PROJECT_ID=hhh-development
FIREBASE_STORAGE_BUCKET=hhh-development.firebasestorage.app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
REQUIRE_APP_CHECK=false
REQUIRE_MFA=false
AUTH_MODE=bearer-observe
SESSION_COOKIE_SECURE=false
PORTAL_APP_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5174
# Required in deployed environments; inject from Secret Manager, never commit it.
IP_HASH_SECRET=replace-with-at-least-32-random-characters
# Postcodes.io is called server-side and requires no API key. BT postcodes remain
# on the manual-allocation path until commercial Northern Ireland use is licensed.
V2_PUBLIC_INTAKE_ENABLED=false
V2_DIRECTORY_ADMIN_ENABLED=false

# Prefer separate least-privilege keys. In deployed Functions, configure them as:
CURALEAF_BASE_URL=https://api.curaleaflaboratories.dev
# Live pharmacy keys are entered through the HHH admin integration workflow and
# stored in one Secret Manager secret per pharmacy. These optional platform keys
# exist only for isolated local/training routes; live tenant requests never use them.
CURALEAF_READ_API_KEY=replace-with-training-read-only-key
CURALEAF_WRITE_API_KEY=replace-with-training-read-write-key
CURALEAF_EVENT_POLLING_ENABLED=false

# Pharmacy customer IDs/portal emails and Worldpay merchant credentials are
# stored per pharmacy in Google Secret Manager through the authenticated API.
WORLDPAY_HPP_BASE_URL=https://try.access.worldpay.com
WORLDPAY_PAYMENT_QUERIES_BASE_URL=https://try.access.worldpay.com
